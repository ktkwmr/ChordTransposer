{
  "name": "chordtransposer",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // Only the app's own paths. The domain root (top page, robots.txt, sitemap.xml, 404) is the
  // ktkwmr-home Worker (ktkwmr/ktkwmr.com, route ktkwmr.com/*); this more specific route wins.
  "routes": [{ "pattern": "ktkwmr.com/chordtransposer*", "zone_name": "ktkwmr.com" }],
  "workers_dev": false,
  // PR branches still get preview URLs (workers_dev: false would turn them off)
  "preview_urls": true,
  // Regenerates ja/index.html, the guide pages, and sitemap.xml before deploy / dev
  "build": { "command": "node scripts/build-ja.mjs && node scripts/build-pages.mjs" },
  // Required by `wrangler preview`, which Workers Builds runs for non-production branches
  "previews": {},
  "assets": {
    "directory": "./public",
    // Unknown URLs get public/404.html with status 404
    "not_found_handling": "404-page"
  }
}
